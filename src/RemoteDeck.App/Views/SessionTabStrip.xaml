<UserControl x:Class="RemoteDeck.App.Views.SessionTabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- The 8 px status dot. The view-model publishes a resource *key* (StatusBrushKey) rather
             than a Brush, and the mapping key -> brush happens here through DynamicResource: a
             brush frozen into the view-model would not follow a light/dark switch, and DynamicResource
             cannot take a Binding. Four triggers, four keys — SessionTabViewModel owns the constants. -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusBrushKey}" Value="SystemFillColorSuccessBrush">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusBrushKey}" Value="SystemFillColorCautionBrush">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusBrushKey}" Value="SystemFillColorCriticalBrush">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The tab itself. Opacity is animated rather than set, so activation fades over 150 ms
             (§7.1); an animation always beats a Setter, hence the plain base value below. -->
        <Style x:Key="TabRootStyle" TargetType="Border">
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="10,0,6,0" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <!-- Transparent, not null: a null Background is not hit-testable, and the whole tab
                 must answer the click, the middle-click and the drag. -->
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The cross: shown on the active tab and on the one under the pointer, so a strip at rest
             stays quiet. AncestorType=Border resolves to the tab root, the nearest Border above. -->
        <Style x:Key="TabCloseStyle" TargetType="ui:Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Visibility" Value="Hidden" />
            <!-- Refused while the window is shutting down: a close started then would race the
                 close-all pass over the very same tab. The ItemsControl's DataContext is the
                 SessionsViewModel; the template's own is the tab. -->
            <Setter Property="IsEnabled"
                    Value="{Binding DataContext.CanCloseTabs, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Horizontal scroll only: more tabs than the window is wide must not make the strip taller. -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  PanningMode="HorizontalOnly">
        <ItemsControl x:Name="TabItems">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource TabRootStyle}"
                            ToolTip="{Binding Subtitle}"
                            MouseLeftButtonDown="OnTabLeftButtonDown"
                            MouseMove="OnTabMouseMove"
                            MouseLeftButtonUp="OnTabLeftButtonUp"
                            MouseDown="OnTabMouseDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource StatusDotStyle}" />
                            <TextBlock Text="{Binding Title}"
                                       VerticalAlignment="Center"
                                       MaxWidth="180"
                                       TextTrimming="CharacterEllipsis" />
                            <ui:Button Style="{StaticResource TabCloseStyle}"
                                       Icon="{ui:SymbolIcon Dismiss16}"
                                       Command="{Binding CloseCommand}"
                                       ToolTip="Close this session (Ctrl+W)" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
