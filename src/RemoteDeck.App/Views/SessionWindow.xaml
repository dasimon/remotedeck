<ui:FluentWindow x:Class="RemoteDeck.App.Views.SessionWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:RemoteDeck.App.Resources"
                 Title="{Binding Title}"
                 Width="1024" Height="720"
                 MinWidth="640" MinHeight="480"
                 ExtendsContentIntoTitleBar="True"
                 WindowStyle="SingleBorderWindow"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="Manual">
    <!-- One detached session and nothing else: a 32 px strip that doubles as the caption, this
         session's InfoBar, and the area the shell drops the WindowsFormsHost into. No pane, no tab
         strip, no palette button — the application chrome stays in the shell.

         There is no ui:TitleBar: ExtendsContentIntoTitleBar leaves the strip below as the only
         caption, which is what makes it 32 px rather than the Fluent default, and the code-behind
         supplies the drag through DragMove(). WindowStyle is declared even though it is the
         default, because full screen swaps it for None and puts this value back.

         The strip and the InfoBar share one Chrome panel because full screen collapses them
         together and brings them back together: the code-behind toggles one Visibility and measures
         one height. -->
    <ui:FluentWindow.Resources>
        <!-- Same four keys and the same DynamicResource indirection as SessionTabStrip: the
             view-model publishes a resource *key*, not a Brush, so the dot follows a light/dark
             switch. Kept local rather than shared because the two dots differ in nothing but their
             margin, and a shared dictionary would be a third file for one Setter. The keys are
             still SessionTabViewModel's; only the brush each one resolves to is now the token
             sheet's, so this caption tells the three states in the three colours the rest of the
             application already uses for them. -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,8,0" />
            <Setter Property="Fill" Value="{DynamicResource RdTextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusBrushKey}" Value="SystemFillColorSuccessBrush">
                    <Setter Property="Fill" Value="{DynamicResource RdOk}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusBrushKey}" Value="SystemFillColorCautionBrush">
                    <Setter Property="Fill" Value="{DynamicResource RdWarn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusBrushKey}" Value="SystemFillColorCriticalBrush">
                    <Setter Property="Fill" Value="{DynamicResource RdBad}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The caption's own buttons. Transparent so the strip reads as one surface, and small
             enough that three of them plus the session actions fit in 32 px.

             BasedOn is not decoration: an explicit Style replaces the implicit one the WPF-UI
             dictionary supplies, so without it the button falls back to the plain WPF template —
             Appearance stops meaning anything and the Icon is never rendered, which is a row of
             blank rectangles on the strip. -->
        <Style x:Key="CaptionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="{StaticResource RdControlHeight}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Appearance" Value="Transparent" />
        </Style>

        <!-- Reconnect and Cancel keep their wording — they are exceptional, and an icon alone would
             not say which of the two is on screen. -->
        <Style x:Key="CaptionTextButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="{StaticResource RdControlHeight}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Chrome" Grid.Row="0">
            <!-- Background is Transparent rather than unset: a null Background is not hit-testable,
                 and the whole strip has to answer the drag. Transparent rather than a surface token
                 for a second reason: the window is Mica, and an opaque ground here would put a flat
                 rectangle where the backdrop should be. The hairline underneath is this strip's only
                 edge, and it is the very one the full-screen bar draws — which is what makes the two
                 read as one piece of chrome rather than two.

                 32 px is RdRowHeight, the closed set's strip height. -->
            <Border x:Name="TitleBarRow"
                    Height="{StaticResource RdRowHeight}"
                    Background="Transparent"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource RdBorder}"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The application icon, for the same reason the shell's title bar carries
                         one: ExtendsContentIntoTitleBar removed the system caption, so a detached
                         window would otherwise be the only piece of RemoteDeck on screen with
                         nothing identifying it. It sits before the status dot — the icon says
                         which application, the dot says how this one session is doing.

                         IsHitTestVisible="False" so the icon does not eat the drag: the whole
                         strip has to answer MouseLeftButtonDown for DragMove(). -->
                    <ui:ImageIcon Grid.Column="0"
                                  Width="16" Height="16"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  Source="pack://application:,,,/RemoteDeck;component/Resources/RemoteDeck-32.png" />

                    <Ellipse Grid.Column="1" Style="{StaticResource StatusDotStyle}" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding Title}"
                               VerticalAlignment="Center"
                               MaxWidth="240"
                               Foreground="{DynamicResource RdText}"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Muted through the token rather than through Opacity, as everywhere else: the
                         subtitle must recede by the same amount in both themes, and 0.7 of white does
                         not recede like 0.7 of black. -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding Subtitle}"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"
                               Foreground="{DynamicResource RdTextMuted}"
                               TextTrimming="CharacterEllipsis" />

                    <ui:Button x:Name="ReconnectButton" Grid.Column="4"
                               Style="{StaticResource CaptionTextButtonStyle}"
                               Content="{x:Static res:Strings.Shell_Reconnect}"
                               Icon="{ui:SymbolIcon ArrowClockwise20}"
                               ToolTip="{x:Static res:Strings.Shell_ReconnectToolTip}"
                               Click="OnReconnectClick" />

                    <ui:Button x:Name="CancelRetryButton" Grid.Column="5"
                               Style="{StaticResource CaptionTextButtonStyle}"
                               Content="{x:Static res:Strings.Common_Cancel}"
                               ToolTip="{x:Static res:Strings.Shell_CancelRetryToolTip}"
                               Click="OnCancelRetryClick" />

                    <ui:Button x:Name="DiagnosticsButton" Grid.Column="6"
                               Style="{StaticResource CaptionButtonStyle}"
                               Icon="{ui:SymbolIcon Copy20}"
                               ToolTip="{x:Static res:Strings.Shell_DiagnosticsToolTip}"
                               Click="OnCopyDiagnosticsClick" />

                    <ui:Button x:Name="ReattachButton" Grid.Column="7"
                               Style="{StaticResource CaptionButtonStyle}"
                               Icon="{ui:SymbolIcon TabDesktop20}"
                               ToolTip="{x:Static res:Strings.SessionWindow_Reattach}"
                               Click="OnReattachClick" />

                    <ui:Button Grid.Column="8"
                               Style="{StaticResource CaptionButtonStyle}"
                               Icon="{ui:SymbolIcon FullScreenMaximize20}"
                               ToolTip="{x:Static res:Strings.SessionWindow_FullScreen}"
                               Click="OnFullScreenClick" />

                    <ui:Button Grid.Column="9"
                               Style="{StaticResource CaptionButtonStyle}"
                               Margin="2,0,4,0"
                               Icon="{ui:SymbolIcon Dismiss20}"
                               ToolTip="{x:Static res:Strings.SessionWindow_Close}"
                               Click="OnCloseClick" />
                </Grid>
            </Border>

            <ui:InfoBar x:Name="StatusBar" Margin="8,0,8,6" IsOpen="False" IsClosable="True" />
        </StackPanel>

        <!-- Named HostAreaBorder so the Decorator the shell writes into can be the public HostArea
             property; black for the same reason as the shell's session area — no theme text colour
             reads well against a remote desktop. -->
        <Border x:Name="HostAreaBorder" Grid.Row="1" Margin="8,0,8,8"
                CornerRadius="{StaticResource RdRadius}" Background="#FF000000" />
    </Grid>
</ui:FluentWindow>
