<ui:FluentWindow x:Class="RemoteDeck.App.Views.ImportWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:RemoteDeck.App.Resources"
                 Title="{x:Static res:Strings.Import_Title}" Width="820" Height="600" MinWidth="640" MinHeight="440"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.Import_Title}" ShowMinimize="False" ShowMaximize="False" />

        <!-- The two sources. Each click replaces the preview: a source is browsed, not accumulated. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,4,16,0">
            <ui:Button x:Name="FolderButton" Content="{x:Static res:Strings.Import_FromFolder}" Icon="{ui:SymbolIcon FolderOpen24}"
                       Margin="0,0,8,0" Click="OnFromFolder"
                       ToolTip="{x:Static res:Strings.Import_FromFolderToolTip}" />
            <ui:Button x:Name="RegistryButton" Content="{x:Static res:Strings.Import_FromRegistry}" Icon="{ui:SymbolIcon Desktop24}"
                       Click="OnFromRegistry"
                       ToolTip="{x:Static res:Strings.Import_FromRegistryToolTip}" />
        </StackPanel>

        <!-- The two promises, in the window itself and not only in the documentation: what import never
             carries, and what the tick means. -->
        <TextBlock Grid.Row="2" Margin="16,10,16,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static res:Strings.Import_Promise}" />

        <ui:InfoBar Grid.Row="3" x:Name="StatusBar" Margin="16,8,16,0" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="4" Margin="16,8,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,6" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Summary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ui:ListView Grid.Row="1" x:Name="List" ItemsSource="{Binding Rows}" SelectionMode="Single">
                <ui:ListView.ItemContainerStyle>
                    <!-- Partial style: WPF still applies the theme style underneath, so only the tooltip
                         is changed here. It carries what has no column — the full source path, the
                         duplicate a row matches, and everything the reader had to drop. -->
                    <Style TargetType="{x:Type ui:ListViewItem}" BasedOn="{StaticResource {x:Type ui:ListViewItem}}">
                        <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                    </Style>
                </ui:ListView.ItemContainerStyle>
                <ui:ListView.View>
                    <ui:GridView>
                        <ui:GridViewColumn Width="36">
                            <ui:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ui:GridViewColumn.CellTemplate>
                        </ui:GridViewColumn>
                        <ui:GridViewColumn Header="{x:Static res:Strings.Import_ColumnName}" Width="200" DisplayMemberBinding="{Binding Name}" />
                        <ui:GridViewColumn Header="{x:Static res:Strings.Import_ColumnAddress}" Width="200" DisplayMemberBinding="{Binding Address}" />
                        <ui:GridViewColumn Header="{x:Static res:Strings.Import_ColumnSource}" Width="180" DisplayMemberBinding="{Binding Source}" />
                        <ui:GridViewColumn Header="{x:Static res:Strings.Import_ColumnStatus}" Width="180" DisplayMemberBinding="{Binding Status}" />
                    </ui:GridView>
                </ui:ListView.View>
            </ui:ListView>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="16,12,16,16">
            <ui:Button Content="{x:Static res:Strings.Import_SelectAllNew}" Icon="{ui:SymbolIcon CheckboxChecked24}" Margin="0,0,8,0" Click="OnSelectAllNew" />
            <ui:Button Content="{x:Static res:Strings.Import_Clear}" Icon="{ui:SymbolIcon Broom24}" Margin="0,0,8,0" Click="OnClear" />
            <ui:Button x:Name="ImportButton" Appearance="Primary" Icon="{ui:SymbolIcon ArrowImport24}"
                       Margin="0,0,8,0" Content="{Binding ImportButtonText}" IsEnabled="{Binding CanImport}"
                       Click="OnImport" />
            <ui:Button Content="{x:Static res:Strings.Import_Close}" Click="OnClose" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
