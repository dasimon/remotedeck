<UserControl x:Class="RemoteDeck.App.Views.ConnectionPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:RemoteDeck.App.Controls"
             xmlns:res="clr-namespace:RemoteDeck.App.Resources"
             MinWidth="220"
             PreviewKeyDown="OnPanePreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- The grouped view of ConnectionListViewModel.Items. A CollectionViewSource declared in the
             resources of the element that uses it inherits that element's DataContext (Freezable
             inheritance context), which is what makes Source="{Binding Items}" resolve. Group order is
             the order the groups are first met in Items, and the view-model already puts favorites
             first, so "★ Favorites" lands on top without a custom group comparer. -->
        <CollectionViewSource x:Key="GroupedConnections" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Two menus, swapped by the right-button handler before WPF opens one: a row and the empty
             space below the last row are different targets and deserve different answers. Both are
             attached to the ListView rather than to the ListViewItem, which is what makes the
             bindings work at all — a ContextMenu is not in the visual tree, so an item-level menu
             could not reach the view-model's commands without a binding proxy. Attached to the list,
             the menu inherits this control's DataContext through its placement target, and every
             command below is the same one the keyboard already runs on the selection. -->
        <ContextMenu x:Key="RowMenu">
            <!-- Bold, and first: the primary action of a row is to connect, the same thing a
                 double-click and Enter do. Windows draws the default verb this way everywhere. -->
            <MenuItem Header="{x:Static res:Strings.Pane_MenuConnect}"
                      FontWeight="SemiBold"
                      Command="{Binding ConnectSelectedCommand}" />
            <Separator />
            <!-- The gesture hint is a resource like every other visible string, even where the two
                 languages agree on it: the rule is "no literal text in the markup", and an exception
                 for the ones that happen to match today is an exception someone has to remember. -->
            <MenuItem Header="{x:Static res:Strings.Pane_MenuEdit}"
                      InputGestureText="{x:Static res:Strings.Pane_MenuGestureEdit}"
                      Command="{Binding EditSelectedCommand}" />
            <!-- OneWay on purpose: the click toggles the check visually, but the value of record is
                 the row's, and the pane reloads right after the write. A TwoWay binding here would
                 fight that reload. -->
            <MenuItem Header="{x:Static res:Strings.Pane_MenuFavorite}"
                      IsCheckable="True"
                      IsChecked="{Binding Selected.IsFavorite, Mode=OneWay}"
                      Command="{Binding ToggleFavoriteSelectedCommand}" />
            <Separator />
            <!-- Destructive, so last and alone under its separator. It arms the same two-step delete
                 the Delete key does — the menu is not a shortcut past the confirmation. -->
            <MenuItem Header="{x:Static res:Strings.Pane_MenuDelete}"
                      InputGestureText="{x:Static res:Strings.Pane_MenuGestureDelete}"
                      Command="{Binding DeleteSelectedCommand}" />
        </ContextMenu>

        <!-- Empty space under the last row: nothing is aimed at, so only the two actions that need no
             target are offered. Reuses the palette's strings rather than translating the same two
             labels twice. -->
        <ContextMenu x:Key="EmptyMenu">
            <MenuItem Header="{x:Static res:Strings.Palette_NewConnection}"
                      InputGestureText="{x:Static res:Strings.Pane_MenuGestureNew}"
                      Command="{Binding NewCommand}" />
            <MenuItem Header="{x:Static res:Strings.Palette_ImportConnections}"
                      Command="{Binding ImportCommand}" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="8,0,4,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TextBox x:Name="SearchBox"
                    Grid.Row="0"
                    Margin="0,0,0,6"
                    PlaceholderText="{x:Static res:Strings.Pane_SearchPlaceholder}"
                    ClearButtonEnabled="True"
                    Icon="{ui:SymbolIcon Search24}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

        <!-- New takes the width; Import sits beside it as an icon, since it is the rarer gesture. -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center"
                       Content="{x:Static res:Strings.Pane_New}"
                       Icon="{ui:SymbolIcon Add24}"
                       Command="{Binding NewCommand}"
                       ToolTip="{x:Static res:Strings.Pane_NewToolTip}" />

            <ui:Button Grid.Column="1"
                       Margin="6,0,0,0"
                       Icon="{ui:SymbolIcon ArrowImport24}"
                       Command="{Binding ImportCommand}"
                       ToolTip="{x:Static res:Strings.Pane_ImportToolTip}"
                       AutomationProperties.Name="{x:Static res:Strings.Pane_ImportToolTip}" />
        </Grid>

        <!-- The workspaces, above the connections and below the two buttons.
             Here rather than only in the palette because a workspace nobody can see is a workspace
             nobody remembers saving: the palette requires knowing the feature exists before you can
             reach it, and this is where the eye already goes. The whole section collapses when there
             is none, so a user who never saves a layout never sees a heading over nothing. -->
        <StackPanel Grid.Row="2"
                    Margin="0,0,0,10"
                    Visibility="{Binding HasWorkspaces, Converter={StaticResource BoolToVisibility}}">
            <!-- Byte for byte the connection groups' header, because it reads as one of them: the
                 pane must not look like two components stacked. Its own style, and not a shared
                 one, only because the group header is generated by a GroupStyle and cannot be
                 pointed at from here. -->
            <Border Background="{DynamicResource RdSurface2}"
                    BorderBrush="{DynamicResource RdBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RdRadiusSm}"
                    Padding="8,3" Margin="6,0,6,2">
                <TextBlock Text="{x:Static res:Strings.Pane_GroupWorkspaces}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource RdTextMuted}" />
            </Border>

            <!-- An ItemsControl, not a ListView: these rows are buttons, not a selection. Selecting a
                 workspace would mean nothing — there is no state to carry between clicking one and
                 doing something with it. -->
            <ItemsControl ItemsSource="{Binding Workspaces}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
        <!-- Tag carries the pane's view-model down to the row, which is the only way the context
                             menu below can reach a command: its own DataContext is the workspace. -->
                        <!-- Same height, margin and padding as a connection row, so the two lists
                             sit on one grid rather than two. -->
                        <Border x:Name="Root"
                                Height="{StaticResource RdRowHeight}"
                                Margin="6,0"
                                Padding="8,0"
                                Background="Transparent"
                                CornerRadius="{StaticResource RdRadiusSm}"
                                Cursor="Hand"
                                ToolTip="{Binding Subtitle}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                MouseLeftButtonUp="OnWorkspaceClick">
                            <Border.ContextMenu>
                                <!-- The menu's DataContext is the row, so the commands have to be
                                     reached through the pane behind it — a ContextMenu sits outside
                                     the visual tree and inherits from its placement target, which is
                                     this Border and not the list. -->
                                <ContextMenu>
                                    <MenuItem Header="{x:Static res:Strings.Pane_MenuOpenWorkspace}"
                                              FontWeight="SemiBold"
                                              Command="{Binding PlacementTarget.Tag.OpenWorkspaceCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <!-- The only way a workspace changes: there is no editor, so
                                         updating one means capturing the open sessions again under
                                         its name. Here rather than left to the user to rediscover by
                                         re-saving and typing the same name from memory. -->
                                    <MenuItem Header="{x:Static res:Strings.Pane_MenuUpdateWorkspace}"
                                              Command="{Binding PlacementTarget.Tag.UpdateWorkspaceCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="{x:Static res:Strings.Pane_MenuDelete}"
                                              Command="{Binding PlacementTarget.Tag.DeleteWorkspaceCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Border.ContextMenu>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Desktop24"
                                               FontSize="14"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource RdTextMuted}" />
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource RdText}" />
                                <TextBlock Text="{Binding Subtitle}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource RdTextMuted}" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource RdSurface2}" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="3">
            <!-- Virtualization stays on: IsVirtualizingWhenGrouping is mandatory, since grouping
                 otherwise realizes every container. ScrollUnit=Pixel gives smooth scrolling while
                 keeping virtualization, unlike ScrollViewer.CanContentScroll="False" — which is the
                 only way to get truly sticky group headers in a plain ListView, and which disables
                 virtualization altogether. Virtualization wins; headers scroll with the content. -->
            <ListView x:Name="List"
                         ItemsSource="{Binding Source={StaticResource GroupedConnections}}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         SelectionMode="Single"
                         BorderThickness="0"
                         Background="Transparent"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyDown="OnListKeyDown"
                         MouseDoubleClick="OnListMouseDoubleClick"
                         PreviewMouseRightButtonDown="OnListPreviewMouseRightButtonDown">
                <ListView.ItemContainerStyle>
                    <!-- A plain WPF ListView, and no longer ui:ListView, because this row needs a
                         template of its own: the three states it must tell apart — hover, selection,
                         keyboard focus — are not the two WPF-UI's Fluent row draws.

                         Measured, not assumed: with ui:ListView the row kept WPF-UI's template even
                         under an explicit Setter, because "ListViewItemStyle" sets Template from a
                         *trigger* and a style trigger outranks a style setter
                         (DependencyPropertyHelper reported BaseValueSource=StyleTrigger on the live
                         container). Inheriting that style through BasedOn therefore means inheriting
                         a template that cannot be replaced. Nothing is lost by leaving: WPF-UI styles
                         ScrollViewer and ScrollBar implicitly, so the list keeps its Fluent scrolling,
                         and the ListView itself is a transparent, border-less box. There is no longer
                         any explicit Style on a Wpf.Ui.Controls.* type here, so global constraint 6
                         no longer has anything to bind. -->
                    <Style TargetType="ListViewItem">
                        <Setter Property="Height" Value="{StaticResource RdRowHeight}" />
                        <!-- 6 px of air on both sides, so the row reads as a card in the pane rather
                             than as a full-bleed band. Nothing vertical: rows stack. -->
                        <Setter Property="Margin" Value="6,0" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="Foreground" Value="{DynamicResource RdText}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <!-- One layer per state, all four stacked and all four transparent
                                         at rest. Opacity is what moves; nothing here changes size or
                                         position, so a list walked with the arrow keys never shifts
                                         under the eye (plan, global constraint 8). -->
                                    <Grid Background="Transparent">
                                        <Border x:Name="Hover"
                                                CornerRadius="{StaticResource RdRadius}"
                                                Background="{DynamicResource RdSurface2}"
                                                Opacity="0" />
                                        <!-- Focus has no ground of its own: measured, RdSurface3 lands on
                                             #80F9F9F9 over a #FAFAFA pane in the light theme — no contrast
                                             at all — so a focused row would have been carried by the
                                             outline in one theme and by two signals in the other. The
                                             outline alone reads in both, and spends the row's one accent
                                             exactly once. -->
                                        <Border x:Name="Selection"
                                                CornerRadius="{StaticResource RdRadius}"
                                                Background="{DynamicResource RdAccentSoft}"
                                                Opacity="0" />
                                        <Border x:Name="FocusRing"
                                                CornerRadius="{StaticResource RdRadius}"
                                                BorderBrush="{DynamicResource RdAccent}"
                                                BorderThickness="1.5"
                                                Opacity="0" />
                                        <!-- The selection rail: 3 px against the left edge, flat on
                                             that side and rounded on the other, and half the row tall
                                             so it reads as a mark rather than as a second border. -->
                                        <Border x:Name="Rail"
                                                Width="3" Height="16"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                CornerRadius="0,3,3,0"
                                                Background="{DynamicResource RdAccent}"
                                                Visibility="Collapsed" />
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <!-- Hover is the only animated state: it is the one a pointer
                                             sweeps through, and 150 ms of fade on a background is what
                                             stops that sweep from flickering. Selection and focus stay
                                             instant — a keyboard user must never wait to see where
                                             they are. Animations are held rather than set, so nothing
                                             else may write this Opacity: it is Hover's alone. -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="{StaticResource RdMotion}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="{StaticResource RdMotion}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>

                                        <!-- Keyboard focus, not focus: a click must not leave an
                                             outline behind, and this list is walked far more often
                                             than it is clicked. -->
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                                        </Trigger>

                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Selection" Property="Opacity" Value="1" />
                                            <Setter TargetName="Rail" Property="Visibility" Value="Visible" />
                                        </Trigger>

                                        <!-- Selected and focused at once — the ordinary case after an
                                             arrow key. The outline goes: rail and outline are both the
                                             accent, in the same place, and only one accent may speak
                                             at a time (plan, global constraint 4). The distinct focus
                                             state is still reachable and still needed, by Ctrl+Arrow,
                                             which moves the focus off the selected row. -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True" />
                                                <Condition Property="IsKeyboardFocused" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="FocusRing" Property="Opacity" Value="0" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <!-- Not RdSurface3: measured, it lands one level off the pane's own
                                     ground in the light theme — the very reason the focus state
                                     above dropped it. The subtle fill reads in both (9 levels light,
                                     13 dark), and the hairline is what actually draws the chip:
                                     15 and 16, the same header whichever theme is on. -->
                                <Border Background="{DynamicResource RdSurface2}"
                                        BorderBrush="{DynamicResource RdBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RdRadiusSm}"
                                        Padding="8,3" Margin="6,6,6,2">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource RdTextMuted}" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="{StaticResource RdRowHeight}">
                            <!-- Name and host both share what the tag leaves, rather than the host
                                 taking what it wants: an Auto host plus an Auto tag overflow a narrow
                                 pane together, and what overflows and gets clipped is the tag — the
                                 one element here that must never be half-read. Weighted 3:2 so the
                                 name, which is what the user searches by, keeps the larger half. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- U+E735 = FavoriteStarFill (Segoe Fluent Icons, Segoe MDL2 Assets on Win10). -->
                            <TextBlock Grid.Column="0" Text="&#xE735;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource RdAccent}"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />

                            <controls:HighlightTextBlock Grid.Column="1"
                                                         Text="{Binding Name}"
                                                         Ranges="{Binding Match.NameRanges}"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource RdText}"
                                                         TextTrimming="CharacterEllipsis" />

                            <!-- Muted through the token rather than through Opacity: the host must
                                 recede by the same amount in both themes, and 0.7 of white does not
                                 recede like 0.7 of black. -->
                            <controls:HighlightTextBlock Grid.Column="2"
                                                         Margin="8,0,0,0"
                                                         Text="{Binding Host}"
                                                         Ranges="{Binding Match.HostRanges}"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Right"
                                                         Foreground="{DynamicResource RdTextMuted}"
                                                         TextTrimming="CharacterEllipsis" />

                            <!-- Only rows with a session of their own show anything here; the rest
                                 collapse the tag and give their width back to the name. -->
                            <controls:StatusTag Grid.Column="3"
                                                Margin="8,0,0,0"
                                                Status="{Binding Status}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Text="{Binding EmptyMessage}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                       Margin="16" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource RdTextMuted}"
                       IsHitTestVisible="False" />
        </Grid>
    </Grid>
</UserControl>
