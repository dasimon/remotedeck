<ui:FluentWindow x:Class="RemoteDeck.App.Views.ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:RemoteDeck.App.Views"
                 xmlns:res="clr-namespace:RemoteDeck.App.Resources"
                 Title="RemoteDeck"
                 Width="1280" Height="800"
                 MinWidth="800" MinHeight="500"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <!-- Two columns: the connection pane, a 4 px splitter, and the sessions area — tab strip on
         top, the active session's WindowsFormsHost below. The title bar spans all three so the
         window keeps one continuous drag surface. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Width and MinWidth are both driven from code: folding the pane (Ctrl+B) sets them
                 to 0, and the saved AppSettings.PaneWidth is applied at startup. -->
            <ColumnDefinition x:Name="PaneColumn" Width="300" MinWidth="220" />
            <ColumnDefinition x:Name="SplitterColumn" Width="4" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <ui:TitleBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Title="RemoteDeck" />

        <Grid x:Name="PaneHost" Grid.Row="1" Grid.Column="0">
            <views:ConnectionPane x:Name="Pane" />
            <!-- Shown instead of the pane when the database could not be opened (spec §6.6): the
                 window stays usable, there is simply nothing saved to connect to. -->
            <TextBlock x:Name="PaneUnavailable"
                       Visibility="Collapsed"
                       Margin="16" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static res:Strings.Pane_Unavailable}" />
        </Grid>

        <GridSplitter x:Name="PaneSplitter"
                      Grid.Row="1" Grid.Column="1"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent"
                      DragCompleted="OnSplitterDragCompleted" />

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Session bar: what the active tab is doing, and the commands that act on it. -->
            <Grid Grid.Row="0" Margin="0,0,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- U+E700 = GlobalNavButton (Segoe Fluent Icons, Segoe MDL2 Assets on Win10):
                     the hamburger that folds the pane. Checked means "pane shown". -->
                <ToggleButton x:Name="PaneToggle" Grid.Column="0"
                              Width="36" Height="32" Padding="0" Margin="0,0,8,0"
                              IsChecked="True"
                              Content="&#xE700;"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              FontSize="14"
                              ToolTip="{x:Static res:Strings.Shell_PaneToggleToolTip}"
                              Click="OnPaneToggleClick" />

                <TextBlock x:Name="SessionLabel" Grid.Column="1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{x:Static res:Strings.Shell_NoSession}" />

                <ui:Button x:Name="ReconnectButton" Grid.Column="2" Margin="8,0,0,0"
                           Content="{x:Static res:Strings.Shell_Reconnect}"
                           Icon="{ui:SymbolIcon ArrowClockwise20}"
                           Visibility="Collapsed"
                           ToolTip="{x:Static res:Strings.Shell_ReconnectToolTip}"
                           Click="OnReconnectClick" />

                <ui:Button x:Name="CancelRetryButton" Grid.Column="3" Margin="8,0,0,0"
                           Content="{x:Static res:Strings.Common_Cancel}"
                           Visibility="Collapsed"
                           ToolTip="{x:Static res:Strings.Shell_CancelRetryToolTip}"
                           Click="OnCancelRetryClick" />

                <ui:Button x:Name="DiagnosticsButton" Grid.Column="4" Margin="8,0,0,0"
                           Icon="{ui:SymbolIcon Copy20}"
                           IsEnabled="False"
                           ToolTip="{x:Static res:Strings.Shell_DiagnosticsToolTip}"
                           Click="OnCopyDiagnosticsClick" />

                <ui:Button Grid.Column="5" Margin="8,0,0,0"
                           Icon="{ui:SymbolIcon Key24}"
                           ToolTip="{x:Static res:Strings.Shell_CredentialsToolTip}"
                           Click="OnManageCredentials" />

                <ui:Button x:Name="DisconnectButton" Grid.Column="6" Margin="8,0,0,0"
                           Content="{x:Static res:Strings.Shell_Disconnect}" IsEnabled="False"
                           ToolTip="{x:Static res:Strings.Session_CloseToolTip}"
                           Click="OnDisconnectClick" />
            </Grid>

            <views:SessionTabStrip x:Name="TabStrip" Grid.Row="1" Margin="0,0,12,6" />

            <ui:InfoBar Grid.Row="2" x:Name="StatusBar" Margin="0,0,12,6" IsOpen="False" IsClosable="True" />

            <Grid Grid.Row="3" Margin="0,0,12,12">
                <!-- Sibling of the session area rather than a child of it: the backdrop behind a
                     remote desktop is black, which no theme text colour reads well against. -->
                <TextBlock x:Name="EmptySessions"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{x:Static res:Strings.Shell_EmptySessions}" />

                <!-- One child per open session, added by SessionsViewModel; the active one is
                     Visible and the others Hidden. Collapsed when there is no tab at all, so the
                     black rectangle does not sit over the message above. -->
                <Border x:Name="SessionsBorder" CornerRadius="6" Background="#FF000000" Visibility="Collapsed">
                    <Grid x:Name="SessionsArea" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
