<ui:FluentWindow x:Class="RemoteDeck.App.Views.ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:RemoteDeck.App.Views"
                 xmlns:res="clr-namespace:RemoteDeck.App.Resources"
                 Title="RemoteDeck"
                 Width="1280" Height="800"
                 MinWidth="800" MinHeight="500"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <!-- Two columns: the connection pane, a 4 px splitter, and the sessions area — tab strip on
         top, the active session's WindowsFormsHost below. The title bar spans all three so the
         window keeps one continuous drag surface. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Width and MinWidth are both driven from code: folding the pane (Ctrl+B) sets them
                 to 0, and the saved AppSettings.PaneWidth is applied at startup. -->
            <ColumnDefinition x:Name="PaneColumn" Width="300" MinWidth="220" />
            <ColumnDefinition x:Name="SplitterColumn" Width="4" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- The Icon is not decoration and not inherited: ExtendsContentIntoTitleBar replaces the
             system caption, so the executable's own icon — which WPF hands to every Window whose
             Icon is unset — never reaches this bar. ui:TitleBar draws one only when given one.

             The source is the 32 px bitmap rather than the .ico: pointed at a multi-frame .ico,
             WPF picks a frame on its own terms, whereas a single 32 px image is an exact 2:1
             reduction at 100 % scaling and pixel-for-pixel at 200 %. -->
        <ui:TitleBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Title="RemoteDeck">
            <ui:TitleBar.Icon>
                <!-- No Width or Height: the ui:TitleBar template already lays the icon out in a
                     16 px box, which is the exact half of the 32 px source. Measured on the
                     running window, the mark spans 14 x 13 px — precisely its geometry at 16 px,
                     so the reduction lands on whole pixels and nothing here needs pinning. -->
                <ui:ImageIcon Source="pack://application:,,,/RemoteDeck;component/Resources/RemoteDeck-32.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid x:Name="PaneHost" Grid.Row="1" Grid.Column="0">
            <views:ConnectionPane x:Name="Pane" />
            <!-- Shown instead of the pane when the database could not be opened (spec §6.6): the
                 window stays usable, there is simply nothing saved to connect to. -->
            <TextBlock x:Name="PaneUnavailable"
                       Visibility="Collapsed"
                       Margin="16" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static res:Strings.Pane_Unavailable}" />
        </Grid>

        <GridSplitter x:Name="PaneSplitter"
                      Grid.Row="1" Grid.Column="1"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent"
                      DragCompleted="OnSplitterDragCompleted" />

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Session bar: what the active tab is doing, and the commands that act on it. -->
            <Grid Grid.Row="0" Margin="0,0,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- U+E700 = GlobalNavButton (Segoe Fluent Icons, Segoe MDL2 Assets on Win10):
                     the hamburger that folds the pane. Checked means "pane shown". -->
                <!-- A plain button, not a ToggleButton: checked, WPF-UI paints a toggle in the
                     accent, and the fold of a side pane was the loudest thing on the screen — the
                     only accent fill in view, louder than New and than the session. The pane
                     itself shows its state; the hamburger only ever means "fold or unfold". -->
                <ui:Button x:Name="PaneToggle" Grid.Column="0"
                           Width="36" Height="32" Padding="0" Margin="0,0,8,0"
                           Icon="{ui:SymbolIcon Navigation24}"
                           ToolTip="{x:Static res:Strings.Shell_PaneToggleToolTip}"
                           AutomationProperties.Name="{x:Static res:Strings.Shell_PaneToggleToolTip}"
                           Click="OnPaneToggleClick" />

                <TextBlock x:Name="SessionLabel" Grid.Column="1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{x:Static res:Strings.Shell_NoSession}" />

                <ui:Button x:Name="ReconnectButton" Grid.Column="2" Margin="8,0,0,0"
                           Content="{x:Static res:Strings.Shell_Reconnect}"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Visibility="Collapsed"
                           ToolTip="{x:Static res:Strings.Shell_ReconnectToolTip}"
                           Click="OnReconnectClick" />

                <ui:Button x:Name="CancelRetryButton" Grid.Column="3" Margin="8,0,0,0"
                           Content="{x:Static res:Strings.Common_Cancel}"
                           Visibility="Collapsed"
                           ToolTip="{x:Static res:Strings.Shell_CancelRetryToolTip}"
                           Click="OnCancelRetryClick" />

                <ui:Button x:Name="DiagnosticsButton" Grid.Column="4" Margin="8,0,0,0"
                           Icon="{ui:SymbolIcon Copy24}"
                           IsEnabled="False"
                           ToolTip="{x:Static res:Strings.Shell_DiagnosticsToolTip}"
                           AutomationProperties.Name="{x:Static res:Strings.Shell_DiagnosticsToolTip}"
                           Click="OnCopyDiagnosticsClick" />

                <ui:Button Grid.Column="5" Margin="8,0,0,0"
                           Icon="{ui:SymbolIcon Key24}"
                           ToolTip="{x:Static res:Strings.Shell_CredentialsToolTip}"
                           AutomationProperties.Name="{x:Static res:Strings.Shell_CredentialsToolTip}"
                           Click="OnManageCredentials" />

                <ui:Button x:Name="DisconnectButton" Grid.Column="6" Margin="8,0,0,0"
                           Content="{x:Static res:Strings.Shell_Disconnect}" IsEnabled="False"
                           ToolTip="{x:Static res:Strings.Session_CloseToolTip}"
                           Click="OnDisconnectClick" />
            </Grid>

            <views:SessionTabStrip x:Name="TabStrip" Grid.Row="1" Margin="0,0,12,6" />

            <ui:InfoBar Grid.Row="2" x:Name="StatusBar" Margin="0,0,12,6" IsOpen="False" IsClosable="True" />

            <Grid Grid.Row="3" Margin="0,0,12,12">
                <!-- Sibling of the session area rather than a child of it: the backdrop behind a
                     remote desktop is black, which no theme text colour reads well against. -->
                <!-- The first thing a new user sees is this, over most of the window. A glyph, a
                     title, the one thing to do, and the two keys that do it, drawn as keys with
                     the palette's own cap, so the two surfaces speak with one voice. -->
                <StackPanel x:Name="EmptySessions"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <ui:SymbolIcon Symbol="Desktop48"
                                   FontSize="{StaticResource RdGlyphHero}"
                                   Foreground="{DynamicResource RdTextMuted}"
                                   HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="{x:Static res:Strings.Shell_EmptySessionsTitle}"
                               FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource RdText}" />
                    <TextBlock Text="{x:Static res:Strings.Shell_EmptySessions}"
                               HorizontalAlignment="Center" Margin="0,4,0,16"
                               Foreground="{DynamicResource RdTextMuted}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Style="{StaticResource RdKeyCap}">
                            <TextBlock Style="{StaticResource RdKeyCapText}" Text="{x:Static res:Strings.Palette_ShortcutNewConnection}" />
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.Shell_EmptyNewHint}" Margin="8,0,20,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource RdTextMuted}" />
                        <Border Style="{StaticResource RdKeyCap}">
                            <TextBlock Style="{StaticResource RdKeyCapText}" Text="{x:Static res:Strings.Shell_ShortcutPalette}" />
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.Shell_EmptyPaletteHint}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource RdTextMuted}" />
                    </StackPanel>
                </StackPanel>

                <!-- One child per open session, added by SessionsViewModel; the active one is
                     Visible and the others Hidden. Collapsed when there is no tab at all, so the
                     black rectangle does not sit over the message above. -->
                <Border x:Name="SessionsBorder" CornerRadius="{StaticResource RdRadius}" Background="{DynamicResource RdSessionGround}" Visibility="Collapsed">
                    <Grid x:Name="SessionsArea" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
