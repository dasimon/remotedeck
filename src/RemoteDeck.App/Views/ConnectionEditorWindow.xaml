<ui:FluentWindow x:Class="RemoteDeck.App.Views.ConnectionEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Connection" Width="520" SizeToContent="Height"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <!-- Every control styles itself inline: an explicit Style= would replace the implicit WPF-UI
         style each ui: control gets from ControlsDictionary, template included. -->
    <StackPanel Margin="0,0,0,12">
        <ui:TitleBar Title="Connection" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Margin="16,0,16,0">
            <TextBlock Text="General" FontWeight="SemiBold" Margin="0,8,0,2" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Name *" VerticalAlignment="Center" />
                <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="NameInput" Margin="0,3"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Text="Host *" VerticalAlignment="Center" />
                <ui:TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" PlaceholderText="server.example.com"
                            Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Text="Port" VerticalAlignment="Center" />
                <ui:NumberBox Grid.Row="2" Grid.Column="1" Margin="0,3" Width="120" HorizontalAlignment="Left"
                              Minimum="1" Maximum="65535" MaxDecimalPlaces="0" SpinButtonPlacementMode="Hidden"
                              Value="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="3" Text="Group" VerticalAlignment="Center" />
                <!-- Editable: pick an existing group or type a new one; KnownGroups is only a shortcut. -->
                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,3" IsEditable="True"
                          ItemsSource="{Binding KnownGroups}"
                          Text="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" Content="Favorite"
                          IsChecked="{Binding IsFavorite}" />
            </Grid>

            <TextBlock Text="Sign-in" FontWeight="SemiBold" Margin="0,12,0,2" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Credential" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" DisplayMemberPath="Label"
                          ItemsSource="{Binding Credentials}" SelectedItem="{Binding SelectedCredential}" />
                <TextBlock Grid.Row="1" Text="Authentication" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" DisplayMemberPath="Label"
                          ItemsSource="{Binding AuthenticationLevels}" SelectedItem="{Binding SelectedAuthenticationLevel}" />
                <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Content="Use web account (experimental)"
                          IsChecked="{Binding UseWebAccount}" />
            </Grid>

            <TextBlock Text="Display" FontWeight="SemiBold" Margin="0,12,0,2" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Display mode" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                          ItemsSource="{Binding DisplayModes}" SelectedItem="{Binding DisplayMode}" />
                <TextBlock Grid.Row="1" Text="Fixed size" VerticalAlignment="Center" />
                <!-- Dynamic follows the window, so both boxes stay disabled until Scaled or Fixed. -->
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,3" Orientation="Horizontal"
                            IsEnabled="{Binding IsFixedSizeEnabled}">
                    <ui:NumberBox Width="110" PlaceholderText="width" Minimum="640" Maximum="8192" MaxDecimalPlaces="0"
                                  SpinButtonPlacementMode="Hidden"
                                  Value="{Binding FixedWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center" />
                    <ui:NumberBox Width="110" PlaceholderText="height" Minimum="480" Maximum="8192" MaxDecimalPlaces="0"
                                  SpinButtonPlacementMode="Hidden"
                                  Value="{Binding FixedHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Redirections" FontWeight="SemiBold" Margin="0,12,0,2" />
            <UniformGrid Columns="2">
                <CheckBox Margin="0,3" Content="Clipboard" IsChecked="{Binding RedirectClipboard}" />
                <CheckBox Margin="0,3" Content="Drives" IsChecked="{Binding RedirectDrives}" />
                <CheckBox Margin="0,3" Content="Printers" IsChecked="{Binding RedirectPrinters}" />
                <CheckBox Margin="0,3" Content="Audio" IsChecked="{Binding RedirectAudio}" />
            </UniformGrid>

            <TextBlock Text="Advanced" FontWeight="SemiBold" Margin="0,12,0,2" />
            <CheckBox Margin="0,3" Content="Admin session (/admin)" IsChecked="{Binding AdminSession}" />
            <ui:TextBox Margin="0,6,0,0" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                        VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                        PlaceholderText="notes" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,4,0,0" Opacity="0.7" FontSize="12" Text="* required" />
        </StackPanel>

        <ui:InfoBar x:Name="ErrorBar" Margin="16,8,16,0" Severity="Error" IsOpen="False" IsClosable="False" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,0">
            <ui:Button Content="Cancel" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
            <ui:Button Content="Save" Appearance="Primary" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
