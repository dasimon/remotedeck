<ui:FluentWindow x:Class="RemoteDeck.App.Views.ConnectionEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:RemoteDeck.App.Resources"
                 Title="{x:Static res:Strings.Editor_Title}" Width="520" SizeToContent="Height"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:FluentWindow.Resources>
    <!-- Every control styles itself inline: an explicit Style= would replace the implicit WPF-UI
         style each ui: control gets from ControlsDictionary, template included. -->
    <StackPanel Margin="0,0,0,12">
        <ui:TitleBar Title="{x:Static res:Strings.Editor_Title}" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Margin="16,0,16,0">
            <TextBlock Text="{x:Static res:Strings.Editor_SectionGeneral}" FontWeight="SemiBold" Margin="0,8,0,2" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Editor_Name}" VerticalAlignment="Center" />
                <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="NameInput" Margin="0,3"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Editor_Host}" VerticalAlignment="Center" />
                <ui:TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" PlaceholderText="{x:Static res:Strings.Editor_HostPlaceholder}"
                            Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Editor_Port}" VerticalAlignment="Center" />
                <ui:NumberBox Grid.Row="2" Grid.Column="1" Margin="0,3" Width="120" HorizontalAlignment="Left"
                              Minimum="1" Maximum="65535" MaxDecimalPlaces="0" SpinButtonPlacementMode="Hidden"
                              Value="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="3" Text="{x:Static res:Strings.Editor_Group}" VerticalAlignment="Center" />
                <!-- Editable: pick an existing group or type a new one; KnownGroups is only a shortcut. -->
                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,3" IsEditable="True"
                          ItemsSource="{Binding KnownGroups}"
                          Text="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" Content="{x:Static res:Strings.Editor_Favorite}"
                          IsChecked="{Binding IsFavorite}" />
            </Grid>

            <TextBlock Text="{x:Static res:Strings.Editor_SectionSignIn}" FontWeight="SemiBold" Margin="0,12,0,2" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Editor_Credential}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" DisplayMemberPath="Label"
                          ItemsSource="{Binding Credentials}" SelectedItem="{Binding SelectedCredential}" />
                <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Editor_Authentication}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" DisplayMemberPath="Label"
                          ItemsSource="{Binding AuthenticationLevels}" SelectedItem="{Binding SelectedAuthenticationLevel}" />
                <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Content="{x:Static res:Strings.Editor_UseWebAccount}"
                          IsChecked="{Binding UseWebAccount}" />
                <!-- The account hint of a web-account connection: what mstsc keeps as UsernameHint for
                     the server. An identity, not a secret — no password is ever attached to it. Only
                     meaningful under the box above, so it shows only then. -->
                <TextBlock Grid.Row="3" Text="{x:Static res:Strings.Editor_WebAccountUpn}" VerticalAlignment="Center"
                           Visibility="{Binding UseWebAccount, Converter={StaticResource BoolToVisibility}}" />
                <ui:TextBox Grid.Row="3" Grid.Column="1" Margin="0,3" PlaceholderText="{x:Static res:Strings.Editor_WebAccountUpnPlaceholder}"
                            Text="{Binding WebAccountUpn, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding UseWebAccount, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,4" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                           Text="{x:Static res:Strings.Editor_WebAccountUpnHint}"
                           Visibility="{Binding UseWebAccount, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <TextBlock Text="{x:Static res:Strings.Editor_SectionDisplay}" FontWeight="SemiBold" Margin="0,12,0,2" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Editor_DisplayMode}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" DisplayMemberPath="Label"
                          ItemsSource="{Binding DisplayModes}" SelectedItem="{Binding SelectedDisplayMode}" />
                <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Editor_FixedSize}" VerticalAlignment="Center" />
                <!-- Dynamic follows the window, so both boxes stay disabled until Scaled or Fixed. -->
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,3" Orientation="Horizontal"
                            IsEnabled="{Binding IsFixedSizeEnabled}">
                    <ui:NumberBox Width="110" PlaceholderText="{x:Static res:Strings.Editor_WidthPlaceholder}" Minimum="640" Maximum="8192" MaxDecimalPlaces="0"
                                  SpinButtonPlacementMode="Hidden"
                                  Value="{Binding FixedWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center" />
                    <ui:NumberBox Width="110" PlaceholderText="{x:Static res:Strings.Editor_HeightPlaceholder}" Minimum="480" Maximum="8192" MaxDecimalPlaces="0"
                                  SpinButtonPlacementMode="Hidden"
                                  Value="{Binding FixedHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{x:Static res:Strings.Editor_SectionRedirections}" FontWeight="SemiBold" Margin="0,12,0,2" />
            <UniformGrid Columns="2">
                <CheckBox Margin="0,3" Content="{x:Static res:Strings.Editor_RedirectClipboard}" IsChecked="{Binding RedirectClipboard}" />
                <CheckBox Margin="0,3" Content="{x:Static res:Strings.Editor_RedirectDrives}" IsChecked="{Binding RedirectDrives}" />
                <CheckBox Margin="0,3" Content="{x:Static res:Strings.Editor_RedirectPrinters}" IsChecked="{Binding RedirectPrinters}" />
                <CheckBox Margin="0,3" Content="{x:Static res:Strings.Editor_RedirectAudio}" IsChecked="{Binding RedirectAudio}" />
            </UniformGrid>

            <TextBlock Text="{x:Static res:Strings.Editor_SectionAdvanced}" FontWeight="SemiBold" Margin="0,12,0,2" />
            <CheckBox Margin="0,3" Content="{x:Static res:Strings.Editor_AdminSession}" IsChecked="{Binding AdminSession}" />
            <TextBlock Margin="0,8,0,2" Text="{x:Static res:Strings.Editor_VpnProfile}" />
            <!-- Editable on purpose: the list is a convenience, not a contract. RemoteDeck reads the
                 RAS phonebook to fill it, and that file's location has never been verified on a
                 machine that has one — so a profile it fails to discover must still be reachable by
                 typing, exactly as before the list existed. -->
            <ComboBox Margin="0,0,0,2"
                      IsEditable="True"
                      ItemsSource="{Binding AvailableVpnProfiles}"
                      Text="{Binding VpnProfile, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,0,0,4" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                       Text="{x:Static res:Strings.Editor_VpnProfileHint}" />
            <ui:TextBox Margin="0,6,0,0" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                        VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                        PlaceholderText="{x:Static res:Strings.Editor_NotesPlaceholder}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,4,0,0" Opacity="0.7" FontSize="12" Text="{x:Static res:Strings.Common_RequiredHint}" />
        </StackPanel>

        <ui:InfoBar x:Name="ErrorBar" Margin="16,8,16,0" Severity="Error" IsOpen="False" IsClosable="False" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,0">
            <ui:Button Content="{x:Static res:Strings.Common_Cancel}" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
            <ui:Button Content="{x:Static res:Strings.Common_Save}" Appearance="Primary" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
