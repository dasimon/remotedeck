<!--
    RemoteDeck design tokens — one sheet, read by every view.

    Colours are never literal here. Each brush derives from a WPF-UI theme colour through a
    DynamicResource on its Color property: the accent stays the user's Windows accent, and a
    light/dark switch reaches the whole application without a restart. A StaticResource would
    freeze the value at load time and break both. Merged into App.xaml AFTER the WPF-UI
    dictionaries — that order is what makes these lookups resolve; merged before, every token
    would silently stay transparent.

    Metrics are closed sets: three radii and three heights. A value outside them is a styling
    defect, not a local decision.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:RemoteDeck.App.Controls">

    <!-- Surfaces, from the window ground up to the selected row. -->
    <SolidColorBrush x:Key="RdSurface0" Color="{DynamicResource ApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="RdSurface1" Color="{DynamicResource CardBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="RdSurface2" Color="{DynamicResource SubtleFillColorSecondary}" />
    <!-- RdSurface3 has no consumer left, and one measurement explains why: in the light theme it
         composites one level off the window's own ground. It is the top of the ladder, not a fill
         anything can be seen on — a view that needs a visible surface takes RdSurface2 and an edge. -->
    <SolidColorBrush x:Key="RdSurface3" Color="{DynamicResource ControlFillColorSecondary}" />

    <!-- Borders. RdBorderStrong is an edge that has to be seen against the surface it encloses —
         the palette's key cap is one — and ControlStrokeColorSecondary cannot do that in the dark
         theme: measured, it composites to #353535 where the cap's own fill lands on #2D2D2D, eight
         levels apart. The strong stroke is the one stroke WinUI defines symmetrically (45 % of
         black, 54 % of white); halved, it reads the same in both themes — measured, 47 levels from
         the fill in each — without naming a colour. -->
    <SolidColorBrush x:Key="RdBorder" Color="{DynamicResource ControlStrokeColorDefault}" />
    <SolidColorBrush x:Key="RdBorderStrong" Color="{DynamicResource ControlStrongStrokeColorDefault}" Opacity="0.5" />

    <!-- Text. -->
    <SolidColorBrush x:Key="RdText" Color="{DynamicResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="RdTextMuted" Color="{DynamicResource TextFillColorSecondary}" />

    <!-- Accent. RdAccentSoft has no equivalent in the theme: it is the same accent colour at low
         opacity, so it still follows the system accent instead of freezing a tinted literal. -->
    <SolidColorBrush x:Key="RdAccent" Color="{DynamicResource AccentFillColorDefault}" />
    <SolidColorBrush x:Key="RdAccentSoft" Color="{DynamicResource AccentFillColorDefault}" Opacity="0.18" />
    <SolidColorBrush x:Key="RdOnAccent" Color="{DynamicResource TextOnAccentFillColorPrimary}" />

    <!-- States. Semantic, never the accent: connected / reconnecting / offline keep their own
         three colours, and a view must double them with a text tag to stay readable without hue. -->
    <SolidColorBrush x:Key="RdOk" Color="{DynamicResource SystemFillColorSuccess}" />
    <SolidColorBrush x:Key="RdWarn" Color="{DynamicResource SystemFillColorCaution}" />
    <SolidColorBrush x:Key="RdBad" Color="{DynamicResource SystemFillColorCritical}" />

    <!-- Radii: small for inline chips, default for rows and tabs, large for panels. -->
    <CornerRadius x:Key="RdRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RdRadius">6</CornerRadius>
    <CornerRadius x:Key="RdRadiusLg">8</CornerRadius>

    <!-- Heights: a list row, a session tab, a button or field inside a bar, and the
         palette's own row — taller than a list row because it stacks a title over a
         subtitle. Named here rather than written into the palette, so the closed set
         stays the closed set and a stray height is still a review finding. -->
    <sys:Double x:Key="RdRowHeight">32</sys:Double>
    <sys:Double x:Key="RdTabHeight">34</sys:Double>
    <sys:Double x:Key="RdControlHeight">28</sys:Double>
    <sys:Double x:Key="RdPaletteRowHeight">42</sys:Double>

    <!-- ============================================================================
         The state pill (controls:StatusTag). It lives here, and not in the pane, because
         its three colours are the three state tokens above: the mapping state -> colour
         belongs to the sheet that owns them.

         Implicit style, no x:Key: StatusTag does not override DefaultStyleKey, so this is
         the only style it will ever get, and every use of the control is styled by merely
         existing. The brushes are DynamicResource — App.xaml.cs re-merges this dictionary
         on a theme change, and a StaticResource here would keep the pill in the theme the
         application started in.

         Radius 999 is the one metric outside the closed set of constraint 3, and it is the
         plan's own exception: a pill is a pill at any height.
         ============================================================================ -->
    <Style TargetType="{x:Type controls:StatusTag}">
        <!-- Foreground is the state colour, and everything in the template derives from it:
             the dot fills with it, the pill tints and outlines with it, the word is written
             in it. One trigger per state is therefore the whole colour story. -->
        <Setter Property="Foreground" Value="{DynamicResource RdTextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatusTag}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{TemplateBinding Foreground}" />
                        <!-- Three layers rather than one border: the tint and the stroke want
                             different opacities of the same colour, and neither may fade the
                             word — a single Border's Opacity would take its child down with it. -->
                        <Grid Margin="6,0,0,0">
                            <Border CornerRadius="999" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                            <Border CornerRadius="999" BorderThickness="1"
                                    BorderBrush="{TemplateBinding Foreground}" Opacity="0.40" />
                            <TextBlock Margin="7,1,7,2"
                                       Text="{TemplateBinding Text}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Status" Value="Connected">
                <Setter Property="Foreground" Value="{DynamicResource RdOk}" />
            </Trigger>
            <Trigger Property="Status" Value="Reconnecting">
                <Setter Property="Foreground" Value="{DynamicResource RdWarn}" />
            </Trigger>
            <Trigger Property="Status" Value="Offline">
                <Setter Property="Foreground" Value="{DynamicResource RdBad}" />
            </Trigger>
            <!-- Nothing to report is reported by nothing at all. Collapsed, not Hidden: a row
                 without a session must not reserve the pill's width. -->
            <Trigger Property="Status" Value="None">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
