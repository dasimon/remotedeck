<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>RemoteDeck.App</RootNamespace>
    <AssemblyName>RemoteDeck</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The icon Windows shows for the executable itself: Explorer, the taskbar, Alt-Tab, the
         properties page. It also becomes every Window's icon for free — WPF falls back to the
         application's own icon whenever Window.Icon is unset, which is the case throughout.
         What it does NOT reach is ui:TitleBar; see the RemoteDeck-32.png Resource below. -->
    <ApplicationIcon>Resources\RemoteDeck.ico</ApplicationIcon>
    <!-- Pinned, not inherited: the MSTSCLib interop below is generated with /machine:X64, so an
         AnyCPU host would fail to load it whenever the process happens not to be x64 — which is
         exactly what a source build on an ARM64 machine produces. x64 also matches the published
         single-file target (spec §11). -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Without this, PublishSingleFile bundles the managed assemblies and leaves every NATIVE
         library beside the executable: PresentationNative_cor3, wpfgfx_cor3, vcruntime140_cor3,
         D3DCompiler_47_cor3, PenImc_cor3 and e_sqlite3. The .exe then looks self-contained and is
         not — run on its own it dies with a DllNotFoundException inside a window procedure, which
         Windows reports as 0xC000041D with no message at all. Measured: that is exactly what the
         published 0.1.0 and 0.2.0 binaries did. The property belongs here rather than in the
         release workflow so that any publish, from anywhere, produces the one file it promises. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WFO0003 tells WinForms apps to declare DPI awareness via ApplicationHighDpiMode /
         ApplicationConfiguration.Initialize(). That path only runs through the WinForms
         bootstrap, which this WPF-entry-point app never executes: UseWindowsForms is on
         solely for WindowsFormsHost/AxHost interop. The manifest is the only mechanism
         that actually applies here, so keep it and silence the WinForms-only diagnostic. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteDeck.Core\RemoteDeck.Core.csproj" />
  </ItemGroup>

  <!-- ===================================================================================
       The title-bar bitmap. ui:TitleBar and the detached window's caption strip draw no icon
       at all unless one is handed to them: ExtendsContentIntoTitleBar replaces the system
       caption, so the ApplicationIcon above never appears there.

       A <Resource> rather than <Content>: it is compiled into the assembly and reached through
       a pack:// URI, which is the only form that survives PublishSingleFile. A Content file
       would sit beside the .exe, and the release workflow deliberately fails a publish whose
       output directory holds anything but RemoteDeck.exe.

       Declared explicitly because no default glob covers it: the WPF SDK auto-includes .xaml
       as Page and nothing else — an image is never picked up on its own.

       This file and Resources\RemoteDeck.ico are both produced by
       tools\icon\New-RemoteDeckIcon.ps1 and committed. CI publishes what is versioned; it does
       not generate artwork.
       ================================================================================== -->
  <ItemGroup>
    <Resource Include="Resources\RemoteDeck-32.png" />
  </ItemGroup>

  <!-- ===================================================================================
       Localisation (spec §9). Strings.resx is the neutral (English) resource and
       Strings.fr.resx its complete French translation; the satellite assembly is produced
       automatically from the .fr file's culture suffix.

       Strings.Designer.cs is committed rather than generated into obj/ by the GenerateResource
       task. XAML binds the strings through {x:Static res:Strings.*}; naming a type of its own
       assembly sends every such view through the WPF markup compiler's second pass, which
       builds a temporary project (RemoteDeck.App_*_wpftmp.csproj) carrying only the plain
       Compile items of this one — its compile chain does not include PrepareResources, so a
       designer produced there is invisible to it and pass 2 fails with CS0103. A committed
       file is an ordinary Compile item and is therefore present in both passes.

       PublicResXFileCodeGenerator keeps it in step inside Visual Studio; the class must be
       public because {x:Static} resolves its member by reflection at load time.
       ================================================================================== -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- ===================================================================================
       MSTSCLib interop.

       An <COMReference> would be the natural way to express this, but the MSBuild task it
       needs (ResolveComReference) exists only in the .NET Framework MSBuild: `dotnet build`
       fails outright with "error MSB4803: The task ResolveComReference is not supported on
       the .NET Core version of MSBuild". Since `dotnet build` is what CI runs, the interop
       assembly is instead generated here by invoking TlbImp.exe directly. Same tool that
       ResolveComReference would have called, same output; no binary is committed, the
       assembly is produced into obj/ at build time.
       ================================================================================== -->
  <PropertyGroup>
    <!-- The registered Remote Desktop ActiveX type library. -->
    <MstscAxTypeLib Condition="'$(MstscAxTypeLib)' == ''">$(SystemRoot)\System32\mstscax.dll</MstscAxTypeLib>

    <WindowsSdkNetFxTools Condition="'$(WindowsSdkNetFxTools)' == ''">$(MSBuildProgramFiles32)\Microsoft SDKs\Windows\v10.0A\bin\NETFX 4.8 Tools</WindowsSdkNetFxTools>
    <!-- Prefer the 64-bit TlbImp: the 32-bit one is subject to WOW64 file-system
         redirection and would silently read %SystemRoot%\SysWOW64\mstscax.dll instead. -->
    <TlbImpPath Condition="'$(TlbImpPath)' == '' And Exists('$(WindowsSdkNetFxTools)\x64\TlbImp.exe')">$(WindowsSdkNetFxTools)\x64\TlbImp.exe</TlbImpPath>
    <TlbImpPath Condition="'$(TlbImpPath)' == ''">$(WindowsSdkNetFxTools)\TlbImp.exe</TlbImpPath>
  </PropertyGroup>

  <Target Name="GenerateMstscInterop"
          Inputs="$(MstscAxTypeLib);$(MSBuildProjectFullPath)"
          Outputs="$(IntermediateOutputPath)Interop.MSTSCLib.dll">
    <Error Condition="!Exists('$(TlbImpPath)')"
           Text="TlbImp.exe not found at '$(TlbImpPath)' - install the Windows SDK / .NET Framework 4.8 developer pack, or set TlbImpPath (e.g. dotnet build -p:TlbImpPath=&quot;C:\path\to\TlbImp.exe&quot;)." />
    <Error Condition="!Exists('$(MstscAxTypeLib)')"
           Text="The Remote Desktop ActiveX type library was not found at '$(MstscAxTypeLib)'. RemoteDeck requires the Windows Remote Desktop client (mstscax.dll); set MstscAxTypeLib to override the path." />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <!-- /transform:DispRet turns the [out, retval] parameter of a dispinterface method into
         a return value. ResolveComReference applies it implicitly; TlbImp.exe does not, and
         without it three IMsTscAxEvents handlers change shape (OnConfirmClose becomes
         void(ref bool) instead of bool(), likewise OnReceivedTSPublicKey and
         OnAutoReconnecting). Keeping it makes this target produce exactly the assembly a
         <COMReference> would have produced.

         /silence:3015 drops TlbImp's TI3015 "cannot be marshaled by the runtime marshaler"
         warnings. All 78 of them concern a single member of Microsoft's own type library,
         IMsRdpClientNonScriptable*.get_UIParentWindowHandle, which returns a
         _RemotableHandle* and which RemoteDeck never calls. There is nothing to fix on our
         side and they would otherwise drown every build. -->
    <Exec Command="&quot;$(TlbImpPath)&quot; &quot;$(MstscAxTypeLib)&quot; /namespace:MSTSCLib /machine:X64 /transform:DispRet /silence:3015 /out:&quot;$(IntermediateOutputPath)Interop.MSTSCLib.dll&quot;"
          StandardOutputImportance="low" />
  </Target>

  <!-- Separate target: GenerateMstscInterop carries Inputs/Outputs and is skipped when the
       assembly is up to date, which would also skip the Reference item if they were merged. -->
  <Target Name="AddMstscInteropReference"
          BeforeTargets="ResolveAssemblyReferences"
          DependsOnTargets="GenerateMstscInterop">
    <ItemGroup>
      <Reference Include="Interop.MSTSCLib">
        <HintPath>$(IntermediateOutputPath)Interop.MSTSCLib.dll</HintPath>
        <Private>true</Private>
        <EmbedInteropTypes>false</EmbedInteropTypes>
      </Reference>
    </ItemGroup>
  </Target>
</Project>
