<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Required by xUnit v3: the runner now lives in the test process instead of loading the
         assembly from outside it, so a test project is an executable rather than a library.
         https://xunit.net/docs/getting-started/v3/migration -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RemoteDeck.Core\RemoteDeck.Core.csproj" />
  </ItemGroup>

</Project>
